# Environment files are loaded by project/settings.py (python-dotenv).
# Copy .env.dev or .env.production as a starting point, or set DJANGO_ENV before starting Django.

# Which file to load: dev (default) | production
# DJANGO_ENV=dev

# Core
# DEBUG=true
# SECRET_KEY=dev-secret-key
# ALLOWED_HOSTS=127.0.0.1,localhost

# HTTPS cookies (production)
# SECURE_SSL_REDIRECT=true
# SESSION_COOKIE_SECURE=true
# CSRF_COOKIE_SECURE=true
# On Gunicorn/Daphne behind Apache (Apache does HTTPS): SECURE_SSL_REDIRECT=false
# USE_X_FORWARDED_PROTO=true

# Public URL for invite links in emails
SITE_URL=http://127.0.0.1:8000
# Subpath mount (production), e.g. /DjangoNotesPro — required for static URLs and WebSocket path stripping
# FORCE_SCRIPT_NAME=/DjangoNotesPro

# Tag search live updates via WebSocket (requires Daphne/ASGI + proxy). Default: on in DEBUG, off in production.
# ENABLE_TAG_WEBSOCKET=true

# Editor toolbar: Insert game / Insert photos (default: true). Existing blocks still render if off.
allowGames=true
allowPhotos=true

# Cache pages on this device and keep editing when the network drops (default: true).
allowOffline=true

# Registration: require email and/or mobile (default: true). If both are false, username + password is enough.
registerMail=true
registerMobile=true
DEFAULT_FROM_EMAIL=notes@yourdomain.com

# Production: encrypt sensitive DB fields (required when DEBUG=false)
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# DB_ENCRYPTION_KEY=

# Dev: print emails in runserver terminal (default)
# DJANGO_EMAIL_BACKEND=console

# Dev: save each email as a file under sent_emails/
# DJANGO_EMAIL_BACKEND=file

# Production: real SMTP (Gmail, Outlook, etc.)
# DJANGO_EMAIL_BACKEND=smtp
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_HOST_USER=your@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password

# Incoming IMAP — poll mailbox for NotesPro:user:workspace:folder:page subjects
# INCOMING_MAIL_IMAP_HOST=imap.gmail.com
# INCOMING_MAIL_IMAP_PORT=993
# INCOMING_MAIL_IMAP_SSL=true
# INCOMING_MAIL_IMAP_USER=your@gmail.com
# INCOMING_MAIL_IMAP_PASSWORD=your-app-password
# INCOMING_MAIL_IMAP_FOLDER=INBOX

# Registration SMS — 6-digit activation code
# Without Twilio, the code prints in the runserver terminal (like console email).
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+15551234567
# SMS_CODE_TTL_MINUTES=15
# Optional Google Drive API key (jukebox folder listing). Public “anyone with the link” files still play without it.
# GOOGLE_DRIVE_API_KEY=
# GOOGLE_API_KEY=

